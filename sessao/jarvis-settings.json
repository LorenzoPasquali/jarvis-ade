{
  "permissions": {
    "allow": [
      "Bash(jarvis status:*)",
      "Bash(jarvis eventos:*)",
      "Bash(jarvis historico:*)",
      "Bash(jarvis clima:*)",
      "Bash(jarvis enviar:*)",
      "Bash(jarvis calar:*)",
      "Bash(jarvis mudo:*)",
      "Bash(orca worktree ps:*)",
      "Bash(orca terminal list:*)",
      "Bash(orca terminal read:*)",
      "Bash(orca terminal show:*)",
      "Bash(orca search:*)",
      "Bash(orca repo list:*)",
      "WebSearch",
      "Monitor"
    ],
    "ask": [
      "Edit(//git/jarvis/sessao/regras.md)"
    ],
    "deny": [
      "Bash(orca terminal send:*)",
      "Read(//git/**/.env)",
      "Read(//git/**/.env.*)",
      "Read(//git/**/*.pem)",
      "Read(//git/**/*.key)",
      "Read(~/.ssh/**)"
    ],
    "additionalDirectories": [
      "/git"
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": false,
    "superpowers@claude-plugins-official": false
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/git/jarvis/bin/jarvis hook-fala",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
